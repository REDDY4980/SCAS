# SCAS Environment Configuration Template — AIB v1.0 Vol 16.5
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. NEVER hardcode secrets in source code.

# --- Application ---
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Database ---
POSTGRES_USER=scas_user
POSTGRES_PASSWORD=
POSTGRES_DB=scas_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scas_user:CHANGE_ME@postgres:5432/scas_db

# --- Weather (Vol 8) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Fallback provider — required before Phase 5 goes live per MASTER_RESOURCE_INDEX
OPENWEATHERMAP_API_KEY=
WEATHER_CACHE_TTL_SECONDS=1800

# --- ML / Model (Vol 9) ---
MODEL_PATH=/app/ml/artifacts/model.joblib
LABEL_ENCODER_PATH=/app/ml/artifacts/label_encoder.joblib
FEATURE_SCHEMA_PATH=/app/ml/artifacts/feature_schema.json

# --- File Storage ---
UPLOAD_DIRECTORY=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=10

# --- OCR (Vol 7) ---
OCR_CONFIDENCE_THRESHOLD=0.85
