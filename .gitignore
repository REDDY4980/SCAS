# Secrets — never commit
.env
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ML artifacts (regenerated by training pipeline; version via ModelRegistry, not git)
ml/artifacts/*.joblib
ml/models/*.joblib

# Flutter
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages

# Storage (runtime data, not source)
storage/uploads/*
storage/logs/*
storage/backups/*
!storage/uploads/.gitkeep
!storage/logs/.gitkeep
!storage/backups/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Database
*.sqlite3
